DATABASE_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/NewPortfolioManagementTool?retryWrites=true&w=majority
PORT=8080
cookieParserKey=replace-with-a-long-random-secret
eToroSecret=replace-with-your-etoro-secret
eToroPublic=replace-with-your-etoro-public-key

# Coin Metrics Community is CC BY-NC 4.0. This portfolio's owner confirmed
# personal noncommercial use. Commercial use requires a licensed API contract.
RISK_DATA_USAGE=personal-noncommercial
# Optional paid Coin Metrics key with CapRealUSD entitlement; never expose it to the browser.
COIN_METRICS_API_KEY=
# Background job: daily history every 6h, Yahoo quotes every 5min while running.
RISK_REFRESH_ENABLED=true
